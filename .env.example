# Novare 配置
# 复制此文件为 .env 并填入你的配置

NOVARE_API_KEY=your-api-key
NOVARE_BASE_URL=https://api.xiaomimimo.com/v1
NOVARE_MODEL=mimo-v2.5
# NOVARE_DATA_DIR=./data
# NOVARE_WORKSPACE=./workspace
# 知识图谱按用户写入 ${NOVARE_WORKSPACE}/{user_id}/knowledge_graph.json
# NOVARE_KG_LLM_EXTRACT=0

# 评审模型（可选，用于双模型对抗评审；留空则禁用）
# NOVARE_REVIEWER_API_KEY=
# NOVARE_REVIEWER_BASE_URL=
# NOVARE_REVIEWER_MODEL=

# MinerU PDF 解析
MINERU_API_TOKEN=your-mineru-jwt-token

# Semantic Scholar
S2_API_KEY=your-s2-api-key

# 百炼 Embedding
DASHSCOPE_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# RAG 混合检索与 Qwen3 Rerank（API Key 默认复用 DASHSCOPE_API_KEY）
RAG_VECTOR_TOP_N=50
RAG_KEYWORD_TOP_N=50
RAG_RRF_K=60
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=qwen3-rerank
RAG_RERANK_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANK_CANDIDATES=20
RAG_RERANK_TIMEOUT=30
RAG_RERANK_MAX_DOC_CHARS=6000
# RAG_RERANK_API_KEY=your-rerank-api-key

# PostgreSQL（生产环境使用 asyncpg）
# 传统 postgresql:// URL 会在内部自动转换为 postgresql+asyncpg://
# 也可以直接使用 postgresql+asyncpg:// 格式
# 生产环境必须配置，缺少时应用启动会报错
DATABASE_URL=postgresql://postgres:password@localhost:5432/research_agent

# JWT Auth
JWT_SECRET_KEY=change-this-to-a-random-secret

# 长期记忆
# NOVARE_ENABLE_LONG_TERM_MEMORY=true
# NOVARE_MAX_MEMORIES_PER_USER=50

# 上下文管理
# NOVARE_AUTO_COMPACT_THRESHOLD=100000
# NOVARE_CONTEXT_MAX_TURNS=3
# NOVARE_CONTEXT_TOKEN_BUDGET=12000
# NOVARE_CONTEXT_SUMMARY_MAX_TOKENS=2500
# NOVARE_CONTEXT_TOOL_RESULT_MAX_TOKENS=1200
# NOVARE_CONTEXT_LLM_TIMEOUT=30
# NOVARE_CONTEXT_LLM_ENABLED=true

# RAG 回答幻觉检测（会增加 LLM 和 RAG 调用，默认关闭）
# NOVARE_HALLUCINATION_VERIFIER_ENABLED=false
# NOVARE_HALLUCINATION_VERIFIER_MAX_CLAIMS=12
# NOVARE_HALLUCINATION_VERIFIER_TOP_K=5
# NOVARE_HALLUCINATION_VERIFIER_CONCURRENCY=3
# NOVARE_HALLUCINATION_VERIFIER_TIMEOUT=120

# Reflexion 与自进化观察模式（仅记录经验和候选报告，不修改 Skill）
# NOVARE_REFLEXION_ENABLED=false
# NOVARE_EVOLUTION_OBSERVE_ENABLED=false
# NOVARE_EVOLUTION_MIN_CONFIDENCE=0.6
# NOVARE_EVOLUTION_MIN_INDEPENDENT_SESSIONS=3
# NOVARE_EVOLUTION_PROPOSAL_ENABLED=false
# NOVARE_EVOLUTION_SKILL_MAX_BYTES=15360
# NOVARE_EVOLUTION_PROPOSAL_MAX_TOKENS=4000
# NOVARE_EVOLUTION_EVAL_MAX_TOKENS=3000
# NOVARE_EVOLUTION_EVAL_MIN_DELTA=0.05
# 成功经验触发：观察模式开启后，复杂成功任务会在后台总结工作流
# NOVARE_EVOLUTION_SUCCESS_ENABLED=true
# NOVARE_EVOLUTION_SUCCESS_MIN_TOOL_CALLS=5
# NOVARE_EVOLUTION_SUCCESS_MIN_UNIQUE_TOOLS=3
# NOVARE_EVOLUTION_SUCCESS_MIN_ITERATIONS=4
# NOVARE_EVOLUTION_SUCCESS_REQUIRE_VERIFICATION=false
# NOVARE_EVOLUTION_SUCCESS_MIN_CONFIDENCE=0.7
# NOVARE_EVOLUTION_SUCCESS_MAX_TOKENS=1800

# 迭代次数限制
# NOVARE_MAX_ITERATIONS=20
# NOVARE_SUBAGENT_MAX_ITERATIONS=16

# 超时（秒）
# NOVARE_TURN_TIMEOUT=300
# NOVARE_SUBAGENT_TURN_TIMEOUT=600

# HTTP 代理（留空则不使用代理，直接连接）
# NOVARE_PROXY=http://127.0.0.1:7890

# Redis（可选，用于会话锁、渠道去重、任务状态、取消任务）
# NOVARE_REDIS_ENABLED=false
# NOVARE_REDIS_URL=redis://localhost:6379/0

# 情景记忆（Episodic Memory，默认关闭）
# NOVARE_EPISODIC_MEMORY_ENABLED=false
# NOVARE_EPISODIC_MEMORY_TOP_K=5
# NOVARE_EPISODIC_MEMORY_MIN_IMPORTANCE=0.6
# NOVARE_EPISODIC_MEMORY_MIN_CONFIDENCE=0.7
# NOVARE_EPISODIC_MEMORY_MIN_SIMILARITY=0.55
# NOVARE_EPISODIC_MEMORY_MAX_PER_TURN=3
# NOVARE_EPISODIC_MEMORY_COLLECTION=episodic_memories

# 批量记忆提取调度
# NOVARE_MEMORY_EXTRACTION_INTERVAL_TURNS=4
# NOVARE_MEMORY_EXTRACTION_IDLE_SECONDS=120
# NOVARE_MEMORY_EXTRACTION_FLUSH_ON_SWITCH=true

# 测试 embedding fallback（生产环境禁止启用）
# NOVARE_TEST_EMBEDDING_FALLBACK=false

# Milvus（情景记忆和论文向量共用）
# MILVUS_HOST=localhost
# MILVUS_PORT=19530
